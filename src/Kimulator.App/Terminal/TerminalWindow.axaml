<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kimulator.App.Terminal.TerminalWindow"
        Title="KIM-1 Teletype"
        Width="760" Height="520"
        Background="#141414">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="8,6">
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <TextBlock Text="Baud" VerticalAlignment="Center" />
                <ComboBox x:Name="BaudBox" Width="96" SelectionChanged="OnBaudChanged" />
                <CheckBox x:Name="UppercaseBox" Content="Uppercase" IsCheckedChanged="OnUppercaseChanged"
                          ToolTip.Tip="Send letters as capitals (the KIM monitor and a Teletype ASR-33 only know upper case)" />
                <CheckBox x:Name="PaperBox" Content="Paper" IsCheckedChanged="OnPaperChanged"
                          ToolTip.Tip="Show the output as printed teletype paper with a typewriter font" />
                <Button Content="Load paper tape…" Click="OnLoadPaperTape"
                        ToolTip.Tip="Type L and send a .ptp file, as if from the Teletype's tape reader" />
                <Button Content="Send text…" Click="OnSendText" ToolTip.Tip="Type the contents of a text file" />
                <Button Content="Save transcript…" Click="OnSaveTranscript" />
                <Button Content="Clear" Click="OnClear" />
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#101010" Padding="8,4">
            <DockPanel>
                <Button x:Name="EnableTtyButton" DockPanel.Dock="Right" Content="Switch KIM to TTY mode" Click="OnEnableTty" Padding="8,2" />
                <TextBlock x:Name="StatusText" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBox x:Name="Screen"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"
                 FontSize="15"
                 Foreground="#FFC24A"
                 Background="#0C0C0C"
                 BorderThickness="0"
                 Padding="10"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TextBox.Resources>
                <!-- Keep the "paper" dark and borderless whether or not the screen has focus. -->
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0C0C0C" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0C0C0C" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFC24A" />
                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFC24A" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </TextBox.Resources>
        </TextBox>
    </DockPanel>
</Window>
